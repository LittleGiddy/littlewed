generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Authentication ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // Nullable for OAuth users
  name          String
  role          String    @default("CLIENT") // "SUPER_ADMIN", "CLIENT", "STAFF"
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  phone         String?   // optional, for admin use
  emailVerified DateTime? // null = not verified (for email/password users)
  isActive      Boolean   @default(false)
  image         String?   // profile picture from Google OAuth

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  notifications Notification[]
}

// ─── NextAuth Models ──────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Your Existing Models ────────────────────────────────────────────────

// Renamed from "VerificationToken" to avoid conflict with NextAuth
model EmailVerificationToken {
  id         String   @id @default(cuid())
  email      String
  otp        String   // 6-digit code
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  subdomain          String   @unique
  plan               String   @default("BASIC")
  status             String   @default("ACTIVE")
  subscriptionStatus String   @default("inactive") // "active" | "inactive" | "cancelled"
  maxGuests          Int      @default(200)
  createdAt          DateTime @default(now())
  credits            Int      @default(0)
  transactions       Transaction[]
  simpleEventMode    Boolean  @default(false)
  bypassPayment      Boolean  @default(false)
  templateCardUrl    String?
  qrPlacementX       Float?
  qrPlacementY       Float?
  qrSize             Int?
  testMode           Boolean  @default(false)
  thanksCardUrl      String?

  users              User[]
  events             Event[]
  pendingEvents      PendingEvent[]
}

model Event {
  id              String   @id @default(cuid())
  name            String
  date            DateTime
  venue           String
  address         String
  total_budget    Int?
  commission_paid Boolean  @default(false)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  guests          Guest[]
  createdAt       DateTime @default(now())
  status        String   @default("DRAFT") // "DRAFT" | "ACTIVE" | "LIVE" | "EXPIRED" | "ARCHIVED"
  pausedAt      DateTime? // when the event was paused/expired
  expiresAt     DateTime? // when the event will be permanently archived
  resumedAt     DateTime? // when the event was last resumed (for tracking)
  reminderSent  Boolean  @default(false) // track if 24h reminder was sent
  expiredNotified Boolean @default(false) // track if expiration email was sent

  // Invitation card fields
  templateCardUrl  String?
  qrPlacementX     Float?
  qrPlacementY     Float?
  qrSize           Int?
  includeName      Boolean? @default(false)
  namePlacementX   Float?
  namePlacementY   Float?
  nameFontSize     Int?
  nameFontColor    String?  @default("#000000")
  customMessage    String?
  qrColor          String?  @default("#000000")
  qrDotStyle       String?  @default("square")
  guestCount       Int?
  designLayers     Json?    // array of layer objects

  // Text overlays
  showEventName   Boolean @default(true)
  eventNameX      Float   @default(50)
  eventNameY      Float   @default(15)
  eventNameSize   Int     @default(28)
  eventNameColor  String  @default("#ffffff")

  showDate        Boolean @default(true)
  dateX           Float   @default(50)
  dateY           Float   @default(25)
  dateSize        Int     @default(18)
  dateColor       String  @default("#ffffff")

  showVenue       Boolean @default(true)
  venueX          Float   @default(50)
  venueY          Float   @default(32)
  venueSize       Int     @default(16)
  venueColor      String  @default("#ffffff")

  overlayColor    String  @default("#000000")
  overlayOpacity  Float   @default(0.2)

  eventNameFontFamily String? @default("Playfair Display")
  dateFontFamily      String? @default("DM Sans")
  venueFontFamily     String? @default("DM Sans")
  nameFontFamily      String? @default("Playfair Display")

  // Thank you card
  thankYouCardUrl       String?
  thankYouMessage       String?
  thankYouMessageX      Float?   @default(50)
  thankYouMessageY      Float?   @default(50)
  thankYouMessageSize   Int?     @default(32)
  thankYouMessageColor  String?  @default("#ffffff")
}

model PendingEvent {
  id           String   @id @default(cuid())
  name         String
  date         DateTime
  venue        String
  address      String
  total_budget Int
  commission   Int
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  guestCount   Int?
}

model Guest {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?
  onWhatsApp     Boolean   @default(false)  @map("on_whatsapp")
  attending      String    @default("pending")
  checkedIn      Boolean   @default(false)
  checkedInAt    DateTime?
  smsCode        String?   @unique
  invitationCard String?
  qrToken        String?
  routingChannel String    @default("sms") @map("routing_channel")
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id])
  createdAt      DateTime  @default(now())
  invitationSentAt   DateTime?
  invitationDeliveredAt DateTime?
  invitationOpenedAt   DateTime?
  thanksSentAt DateTime?
  reminderCount   Int      @default(0)
  guestType  String?  // 'single', 'double', or any custom value
}

model UsageRecord {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String?
  channel   String   // "whatsapp" or "sms"
  cost      Int      // in same unit as credits
  createdAt DateTime @default(now())
}

model Transaction {
  id              String   @id @default(cuid())
  amount          Int
  type            String   // "CREDIT_PURCHASE" or "COMMISSION_PAYMENT"
  status          String   // "PENDING", "COMPLETED", "FAILED"
  stripeSessionId String?
  tenantId        String
  eventId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String?
  type      String   // "info", "warning", "success", "alert"
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Template {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String   // URL to the template image
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncomingEmail {
  id          String   @id @default(cuid())
  from        String
  to          String[]
  subject     String
  html        String?
  text        String?
  messageId   String?
  repliedTo   String?
  receivedAt  DateTime @default(now())
  eventId     String?  // Link to the original event
  guestId     String?  // Link to the guest who replied
  processedAt DateTime?
}