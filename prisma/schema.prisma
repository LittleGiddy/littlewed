generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Authentication ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // Nullable for OAuth users
  name          String
  role          String    @default("CLIENT") // "SUPER_ADMIN", "CLIENT", "STAFF"
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  phone         String?   // optional, for admin use
  emailVerified DateTime? // null = not verified (for email/password users)
  isActive      Boolean   @default(false)
  image         String?   // profile picture from Google OAuth

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  notifications Notification[]
  pushSubscriptions PushSubscription[]
}

// ─── NextAuth Models ──────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Your Existing Models ────────────────────────────────────────────────

model EmailVerificationToken {
  id         String   @id @default(cuid())
  email      String
  otp        String   // 6-digit code
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  subdomain          String   @unique
  plan               String   @default("BASIC")
  status             String   @default("ACTIVE")
  subscriptionStatus String   @default("inactive") // "active" | "inactive" | "cancelled"
  maxGuests          Int      @default(200)
  createdAt          DateTime @default(now())
  credits            Int      @default(0)
  creditsEnabled     Boolean  @default(true) // super admin can suspend credit usage
  transactions       Transaction[]
  simpleEventMode    Boolean  @default(false)
  bypassPayment      Boolean  @default(false)
  adminEmail         String?  // email for credit request notifications
  templateCardUrl    String?
  qrPlacementX       Float?
  qrPlacementY       Float?
  qrSize             Int?
  testMode           Boolean  @default(false)
  thanksCardUrl      String?
  whatsappTemplate      String?  @default("event_invitation")
  whatsappAccount       String?  @default("TANZANIATIP")

  users              User[]
  events             Event[]
  pendingEvents      PendingEvent[]
  creditRequests     CreditRequest[]
  systemLogs         SystemLog[]
}

model Event {
  id              String   @id @default(cuid())
  name            String
  date            DateTime
  venue           String
  address         String
  total_budget    Int?
  commission_paid Boolean  @default(false)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guests          Guest[]
  createdAt       DateTime @default(now())
  status        String   @default("DRAFT") // "DRAFT" | "ACTIVE" | "LIVE" | "EXPIRED" | "ARCHIVED"
  pausedAt      DateTime? // when the event was paused/expired
  expiresAt     DateTime? // when the event will be permanently archived
  resumedAt     DateTime? // when the event was last resumed (for tracking)
  reminderSent  Boolean  @default(false) // track if 24h reminder was sent
  manualReminderSent Boolean @default(false) // track if the manual reminder-message feature was used (once per event for non-bypassed tenants)
  expiredNotified Boolean @default(false) // track if expiration email was sent
  checkInStartTime  DateTime? // When check-in becomes available (defaults to event date/time)
  qrRotation       Float?   @default(0)

  // ─── Wedding-specific fields ─────────────────────────────────────────
  hostFamily  String?  // e.g., "Mr & Mrs Allan Swai"
  person1     String?  // e.g., "Agape"
  person2     String?  // e.g., "Gladness"
  time        String?  // e.g., "5:00 PM"
  imageUrl    String?  // Header image URL

  // Invitation card fields
  templateCardUrl  String?
  qrPlacementX     Float?
  qrPlacementY     Float?
  qrSize           Int?
  includeName      Boolean? @default(false)
  namePlacementX   Float?
  namePlacementY   Float?
  nameFontSize     Int?
  nameFontColor    String?  @default("#000000")
  customMessage    String?
  qrColor          String?  @default("#000000")
  qrDotStyle       String?  @default("square")
  guestCount       Int?
  designLayers     Json?    // array of layer objects

  // Text overlays
  showEventName   Boolean @default(true)
  eventNameX      Float   @default(50)
  eventNameY      Float   @default(15)
  eventNameSize   Int     @default(28)
  eventNameColor  String  @default("#ffffff")

  showDate        Boolean @default(true)
  dateX           Float   @default(50)
  dateY           Float   @default(25)
  dateSize        Int     @default(18)
  dateColor       String  @default("#ffffff")

  showVenue       Boolean @default(true)
  venueX          Float   @default(50)
  venueY          Float   @default(32)
  venueSize       Int     @default(16)
  venueColor      String  @default("#ffffff")

  overlayColor    String  @default("#000000")
  overlayOpacity  Float   @default(0.2)

  eventNameFontFamily String? @default("Playfair Display")
  dateFontFamily      String? @default("DM Sans")
  venueFontFamily     String? @default("DM Sans")
  nameFontFamily      String? @default("Playfair Display")

  // Thank you card
  thankYouCardUrl       String?
  thankYouMessage       String?
  thankYouMessageX      Float?   @default(50)
  thankYouMessageY      Float?   @default(50)
  thankYouMessageSize   Int?     @default(32)
  thankYouMessageColor  String?  @default("#ffffff")
}

model PendingEvent {
  id           String   @id @default(cuid())
  name         String
  date         DateTime
  venue        String
  address      String
  total_budget Int
  commission   Int
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  guestCount   Int?
}

model Guest {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?
  onWhatsApp     Boolean   @default(false)  @map("on_whatsapp")
  attending      String    @default("pending")
  checkedIn      Boolean   @default(false)
  checkedInAt    DateTime?
  invitationCard String?
  checkInCount   Int       @default(0)
  maxCheckIns    Int       @default(1)
  qrToken        String?
  routingChannel String    @default("sms") @map("routing_channel")
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  invitationSentAt   DateTime?
  invitationDeliveredAt DateTime?
  invitationOpenedAt   DateTime?
  thanksSentAt DateTime?
  reminderCount   Int      @default(0)
  guestType  String?   @default("SINGLE")
  title          String?   @default("Mr")
  cardNumber     String?   @unique
  waId           String?   // WhatsApp ID from Meta
  passCode       String?   @unique

  // ─── Relations ──────────────────────────────────────────────────────────
  messageLogs MessageLog[]

  @@index([eventId])
  @@index([phone])
  @@index([cardNumber])
  @@index([passCode])
}

model UsageRecord {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String?
  channel   String   // "whatsapp" or "sms"
  cost      Int      // in same unit as credits
  createdAt DateTime @default(now())
}

model CreditRequest {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  requestedCredits Int
  amountTZS       Int      // requestedCredits * 500
  reason          String?
  status          String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedBy      String?  // super admin user ID
  reviewedAt      DateTime?
  grantedCredits  Int?     // credits actually granted (may differ from requested)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model Transaction {
  id              String   @id @default(cuid())
  amount          Int
  type            String   // "CREDIT_PURCHASE" or "COMMISSION_PAYMENT"
  status          String   // "PENDING", "COMPLETED", "FAILED"
  stripeSessionId String?
  tenantId        String
  eventId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ─── ✅ ADD THIS NEW MODEL ───────────────────────────────────────────────
model PasswordResetSession {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String?
  type      String   // "info", "warning", "success", "alert"
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  keysP256dh String
  keysAuth   String
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String   // URL to the template image
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncomingEmail {
  id          String   @id @default(cuid())
  from        String
  to          String[]
  subject     String
  html        String?
  text        String?
  messageId   String?
  repliedTo   String?
  receivedAt  DateTime @default(now())
  eventId     String?  // Link to the original event
  guestId     String?  // Link to the guest who replied
  processedAt DateTime?
}

// ─── Message Logging Models ──────────────────────────────────────────────

model MessageLog {
  id          String   @id @default(cuid())
  messageId   String   @unique
  guestId     String?
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  type        String   // WHATSAPP, SMS
  template    String?
  status      String   // SENT, PENDING, DELIVERED, FAILED, REJECTED
  error       String?
  createdAt   DateTime @default(now())
  deliveredAt DateTime?
  rawData     Json?

  @@index([messageId])
  @@index([status])
  @@index([createdAt])
}

model DeliveryLog {
  id          String   @id @default(cuid())
  messageId   String
  status      String
  rawData     Json
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([createdAt])
}

// ─── System / Technical Logging (super admin monitoring) ───────────────────
// Captures card generation failures, send failures and other technical events
// that never reach a MessageLog (e.g. card image render errors, provider
// failures) so the super admin can monitor all tenants' technical health.

model SystemLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  eventId   String?
  guestId   String?
  type      String   // e.g. "card_generation", "send", "technical"
  level     String   @default("ERROR") // "ERROR" | "WARN" | "INFO"
  message   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdAt])
}